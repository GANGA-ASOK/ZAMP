# MongoDB Atlas Connection
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net"
DATABASE_NAME=zamp

# JWT Authentication (for production)
JWT_SECRET_KEY=replace-with-a-secure-random-64-character-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# NVIDIA AI Nemotron Models
NVIDIA_API_KEY="nvapi-your-nvidia-api-key-here"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_PARSE_MODEL="nvidia/nemotron-parse"
NVIDIA_SUPER_VL_MODEL="nvidia/nemotron-3.5-super-vl-120b-a12b"

# Optional: text reasoning model used by the AI Decision Engine for identity
# extraction and the reviewer stage (defaults to NVIDIA_SUPER_VL_MODEL).
# NVIDIA_REASONING_MODEL="nvidia/nemotron-3.5-super-vl-120b-a12b"
# Set to "true" to force deterministic rules only (no NVIDIA calls).
# NVIDIA_MOCK_MODE="false"
